# Database Configuration
SUPABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DB_CONNECT_TIMEOUT_SECONDS=5

# Firebase Admin Configuration (for Push Notifications)
FIREBASE_CERT_PATH=backend/services/firebase-auth.json

# Optional Twilio Delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# API Security
SEHAS_API_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081

# Alert Processing
ALERT_SAFETY_WINDOW_SECONDS=10
ALERT_ESCALATION_SECONDS=120
ALERT_WORKER_POLL_SECONDS=2

# API Runtime
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

{
  "expo": {
    "name": "SEHAS Patient",
    "slug": "sehas-patient-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sehas",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E1A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SEHAS uses the camera and flash for heart rate measurement via PPG",
        "NSMicrophoneUsageDescription": "SEHAS uses the microphone for voice SOS detection",
        "NSLocationWhenInUseUsageDescription": "SEHAS tracks your location to share with caregivers during emergencies",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "SEHAS monitors your location for geofencing safety alerts",
        "NSMotionUsageDescription": "SEHAS uses motion sensors for fall detection"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0E1A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "VIBRATE",
        "HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "VIBRATE",
        "HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.yaiphaba1.sehaspatientapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SEHAS needs camera access for heart rate measurement",
          "microphonePermission": "SEHAS needs microphone for voice SOS detection"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SEHAS monitors location for emergency geofencing"
        }
      ],
      "expo-sensors",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
